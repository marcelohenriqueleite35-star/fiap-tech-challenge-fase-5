# Login na Azure com service principal. Use quando o `az login --use-device-code` for bloqueado
# (erro AADSTS530035, "blocked by security defaults"). Passo a passo no README, seção 2.5.
#
# Copie para .env.azure e preencha. O .env.azure fica fora do Git e é carregado
# automaticamente por scripts/terraform.sh, scripts/az.sh e scripts/deploy.sh.
ARM_TENANT_ID=
ARM_CLIENT_ID=
ARM_CLIENT_SECRET=
ARM_SUBSCRIPTION_ID=
